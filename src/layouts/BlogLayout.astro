---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: string;
  heroImage?: string;
  category?: string;
  readTime?: string;
}

// In Astro 4 MDX, frontmatter is passed both as direct props and under Astro.props.frontmatter
const fm = Astro.props.frontmatter ?? Astro.props;
const { title, description, pubDate, heroImage, category = 'Iceland', readTime = '5 min read' } = fm;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<Layout title={title} description={description} image={heroImage} ogType="article">
  <article>
    {heroImage && (
      <div class="blog-hero">
        <img src={heroImage} alt={title} />
      </div>
    )}

    <div class="blog-article container">
      <header class="blog-header">
        <span class="badge badge--green">{category}</span>
        <h1>{title}</h1>
        {description && <p class="lead">{description}</p>}
        <div class="blog-meta">
          <time datetime={pubDate}>{formattedDate}</time>
          <span class="dot">·</span>
          <span>{readTime}</span>
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      <div class="blog-footer">
        <a href={`${import.meta.env.BASE_URL}journal`} class="btn btn--outline">&larr; Back to Journal</a>
      </div>
    </div>
  </article>
</Layout>

<style>
.blog-hero {
  width: 100%;
  max-height: 520px;
  overflow: hidden;
}
.blog-hero img {
  width: 100%;
  height: 520px;
  object-fit: cover;
}

.blog-article {
  padding-block: 3rem 5rem;
}

.blog-header {
  max-width: 740px;
  margin-inline: auto;
  margin-bottom: 3rem;
  text-align: center;
}
.blog-header h1 {
  margin-top: .75rem;
  margin-bottom: .75rem;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
}
.lead {
  font-size: 1.15rem;
  color: var(--color-mid);
  line-height: 1.7;
}
.blog-meta {
  margin-top: 1rem;
  font-size: .88rem;
  color: var(--color-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
}
.dot { font-size: .6rem; }

.blog-footer {
  max-width: 740px;
  margin-inline: auto;
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border);
}
</style>
