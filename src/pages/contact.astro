---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & Booking — Iceland Camp Gear"
  description="Book your camping equipment rental in Iceland or get in touch with any questions. We're based in Reykjavík and happy to help plan your trip."
>

  <div class="page-hero">
    <div class="container">
      <span class="badge badge--white">Get In Touch</span>
      <h1>Contact & Booking</h1>
      <p>Questions about gear, need a custom bundle, or ready to book? We're here to help.</p>
    </div>
  </div>

  <section class="section">
    <div class="container contact-layout">

      <!-- Info column -->
      <div class="contact-info">
        <div class="info-block">
          <h3>📍 Location & Pickup</h3>
          <address>
            <p>IcelandCampGear Warehouse<br />Reykjavík, Iceland</p>
            <p>Free pickup at our warehouse. We also offer delivery anywhere in Iceland — contact us for a quote.</p>
          </address>
        </div>

        <div class="info-block">
          <h3>📞 Phone & Email</h3>
          <p><a href="tel:+3545551234">+354 555 1234</a></p>
          <p><a href="mailto:hello@icelandcampgear.com">hello@icelandcampgear.com</a></p>
        </div>

        <div class="info-block">
          <h3>🕐 Opening Hours</h3>
          <table class="hours-table">
            <tr><td>Monday – Friday</td><td>8:00 – 19:00</td></tr>
            <tr><td>Saturday</td><td>8:00 – 18:00</td></tr>
            <tr><td>Sunday</td><td>9:00 – 17:00</td></tr>
            <tr class="summer-row"><td colspan="2">June – August: Extended hours daily until 20:00</td></tr>
          </table>
        </div>

        <div class="info-block">
          <h3>💡 Before You Book</h3>
          <ul class="pre-book-tips">
            <li>Check our <a href={`${import.meta.env.BASE_URL}equipment`}>equipment page</a> for individual item availability and pricing.</li>
            <li>See our <a href={`${import.meta.env.BASE_URL}bundles`}>bundles page</a> for the best-value combinations.</li>
            <li>Minimum rental is 2 days. Contact us for multi-week discounts.</li>
            <li>We recommend booking at least 3–5 days in advance, especially in peak season (June–August).</li>
          </ul>
        </div>
      </div>

      <!-- Booking form -->
      <div class="contact-form-wrap" id="booking">
        <h2>Send a booking request</h2>
        <p>Fill in the form and we'll get back to you within a few hours with availability and a final price.</p>

        <form class="booking-form" action="#" method="post" name="booking" netlify>
          <div class="form-row">
            <div class="form-group">
              <label for="first-name">First name *</label>
              <input type="text" id="first-name" name="first-name" required autocomplete="given-name" />
            </div>
            <div class="form-group">
              <label for="last-name">Last name *</label>
              <input type="text" id="last-name" name="last-name" required autocomplete="family-name" />
            </div>
          </div>

          <div class="form-group">
            <label for="email">Email address *</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="phone">Phone number</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="pickup-date">Pickup date *</label>
              <input type="date" id="pickup-date" name="pickup-date" required />
            </div>
            <div class="form-group">
              <label for="return-date">Return date *</label>
              <input type="date" id="return-date" name="return-date" required />
            </div>
          </div>

          <div class="form-group">
            <label for="group-size">Group size *</label>
            <select id="group-size" name="group-size" required>
              <option value="">Select…</option>
              <option value="1">1 person (Solo)</option>
              <option value="2">2 people (Couple)</option>
              <option value="3">3 people</option>
              <option value="4">4 people (Family)</option>
              <option value="5-6">5–6 people (Group)</option>
              <option value="7+">7+ people (Large group)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="bundle">Interested in</label>
            <select id="bundle" name="bundle">
              <option value="">Select a bundle or custom…</option>
              <option value="solo">Solo Adventurer Bundle</option>
              <option value="couple">Couple's Bundle</option>
              <option value="family">Family Bundle</option>
              <option value="group">Group Explorer Bundle</option>
              <option value="premium">Premium Couple Bundle</option>
              <option value="custom">Custom — I'll describe below</option>
            </select>
          </div>

          <div class="form-group">
            <label for="pickup-location">Pickup / delivery preference</label>
            <select id="pickup-location" name="pickup-location">
              <option value="">Select…</option>
              <option value="warehouse">Pickup at Reykjavík warehouse</option>
              <option value="hotel">Delivery to Reykjavík hotel/guesthouse</option>
              <option value="airport">Delivery to Keflavík Airport</option>
              <option value="other">Other location (describe below)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Additional details / custom gear requests</label>
            <textarea id="message" name="message" rows="5" placeholder="Tell us about your trip, any specific gear you need, your route, etc."></textarea>
          </div>

          <button type="submit" class="btn btn--primary submit-btn">
            Send Booking Request
          </button>

          <p class="form-note">We'll respond within a few hours during opening hours. Submitting this form doesn't confirm your booking — we'll confirm availability and send you a payment link.</p>
        </form>
      </div>

    </div>
  </section>

  <!-- FAQ teaser -->
  <section class="section section--tint" id="faq">
    <div class="container">
      <div class="section-header">
        <span class="badge badge--green">FAQ</span>
        <h2>Common questions</h2>
        <div class="divider"></div>
      </div>
      <div class="faq-grid">
        <details class="faq-item">
          <summary>How far in advance should I book?</summary>
          <p>We recommend booking 3–7 days in advance during peak season (June–August). Outside of peak season, even same-day bookings are often possible. For large groups or custom bundles, earlier is always better.</p>
        </details>
        <details class="faq-item">
          <summary>Can I pick up at the airport?</summary>
          <p>Yes! We offer delivery to Keflavík Airport for a small additional fee. Let us know your flight details when booking and we'll have your gear waiting.</p>
        </details>
        <details class="faq-item">
          <summary>What if something breaks during my trip?</summary>
          <p>Accidents happen. Contact us as soon as possible and we'll do our best to help — whether that's sending a replacement or advising on a fix. Damage insurance covers accidental damage for 15% of your rental cost.</p>
        </details>
        <details class="faq-item">
          <summary>Do you rent fuel canisters?</summary>
          <p>Yes — gas canisters are included with all stove rentals. We'll send you with full canisters and you can return partially used ones at no charge.</p>
        </details>
        <details class="faq-item">
          <summary>What's your cancellation policy?</summary>
          <p>Free cancellation up to 72 hours before pickup. Within 72 hours: 50% refund. No-shows: no refund. We understand plans change — contact us if you have a genuine emergency and we'll do our best.</p>
        </details>
        <details class="faq-item">
          <summary>Do you offer multi-week discounts?</summary>
          <p>Yes — rentals of 10 days or more receive a 15% discount. Long-term rentals (21+ days) get 25% off. Contact us to arrange a multi-week booking.</p>
        </details>
      </div>
    </div>
  </section>

</Layout>

<style>
.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 4rem;
  align-items: start;
}

.contact-info { display: flex; flex-direction: column; gap: 2rem; }
.info-block h3 { font-family: var(--font-sans); font-size: .95rem; font-weight: 700; margin-bottom: .75rem; color: var(--color-green-dark); }
.info-block address { font-style: normal; }
.info-block p { font-size: .92rem; color: var(--color-mid); margin-bottom: .35rem; }
.info-block a { color: var(--color-green); font-weight: 500; }
.info-block a:hover { text-decoration: underline; }

.hours-table { font-size: .88rem; width: 100%; border-collapse: collapse; }
.hours-table td { padding: .25rem .5rem .25rem 0; color: var(--color-dark); }
.hours-table td:last-child { text-align: right; color: var(--color-mid); }
.summer-row td { padding-top: .5rem; color: var(--color-green-dark); font-size: .82rem; border-top: 1px solid var(--color-border); }

.pre-book-tips { display: flex; flex-direction: column; gap: .5rem; }
.pre-book-tips li { font-size: .88rem; color: var(--color-mid); padding-left: 1rem; position: relative; }
.pre-book-tips li::before { content: '·'; position: absolute; left: 0; }
.pre-book-tips a { color: var(--color-green); }
.pre-book-tips a:hover { text-decoration: underline; }

.contact-form-wrap { background: var(--color-white); border-radius: var(--radius-xl); padding: 2.5rem; box-shadow: var(--shadow-md); }
.contact-form-wrap h2 { margin-bottom: .35rem; }
.contact-form-wrap > p { font-size: .92rem; color: var(--color-mid); margin-bottom: 1.75rem; }

.booking-form { display: flex; flex-direction: column; gap: 1.1rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.submit-btn { width: 100%; justify-content: center; padding: .9rem; font-size: 1rem; }
.form-note { font-size: .8rem; color: var(--color-muted); line-height: 1.5; }

.faq-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(340px,100%),1fr));
  gap: 1px;
  background: var(--color-border);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.faq-item {
  background: var(--color-white);
  padding: 1.25rem 1.5rem;
}
.faq-item summary {
  font-weight: 600;
  font-size: .95rem;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after { content: '+'; font-size: 1.2rem; color: var(--color-green); flex-shrink: 0; }
.faq-item[open] summary::after { content: '−'; }
.faq-item p { font-size: .9rem; color: var(--color-mid); margin-top: .75rem; line-height: 1.65; }

@media (max-width: 900px) {
  .contact-layout { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .form-row { grid-template-columns: 1fr; }
  .contact-form-wrap { padding: 1.5rem; }
}
</style>
